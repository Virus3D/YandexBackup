{
    "name": "virus3d/db-backup",
    "description": "Автоматический бэкап баз данных на Яндекс.Диск с ротацией",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "vlucas/phpdotenv": "^5.5",
        "psr/log": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\Backup\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}